{{- /* Client-side search index. One entry per content page, carrying its version
       segment so search.js can scope results to the version being read. A preview page
       keeps its whole text, so the docs MCP (/mcp) finds its later sections; every other
       version is cut at 4000 characters. */ -}}
{{- $list := slice -}}
{{- range where site.RegularPages "Kind" "page" -}}
  {{- $seg := index (split (strings.TrimPrefix "/" .RelPermalink) "/") 0 -}}
  {{- $list = $list | append (dict
      "title"   .Title
      "url"     .RelPermalink
      "version" (strings.TrimPrefix "v" $seg)
      "section" .CurrentSection.Title
      "lede"    (.Params.lede | default "")
      "text"    (cond (eq (strings.TrimPrefix "v" $seg) site.Params.versions.preview) .Plain (.Plain | truncate 4000 ""))
  ) -}}
{{- end -}}
{{- $list | jsonify -}}
