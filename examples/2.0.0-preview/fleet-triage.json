{
  "key": "fleet-triage", "version": 1,
  "name": "Fleet server triage",
  "summary": "Tells a banned server from a dead one from a checker problem, from pushed checks.",
  "fields": [
    {"key": "provider", "label": "Provider", "type": "string"},
    {"key": "ratio_threshold", "label": "Traffic ratio threshold", "type": "number",
     "default": 0.5, "min": 0, "help": "Below this share of the baseline, traffic counts as gone."}
  ],
  "signals": [
    {"key": "region_a", "kind": "heartbeat", "every_seconds": 300},
    {"key": "region_b", "kind": "heartbeat", "every_seconds": 300},
    {"key": "control", "kind": "heartbeat", "every_seconds": 300},
    {"key": "host_health", "kind": "heartbeat", "every_seconds": 300},
    {"key": "traffic_ratio", "kind": "heartbeat", "every_seconds": 300}
  ],
  "rules": [
    {"key": "banned", "action": "Replace the server.",
     "wait": {"confirm_after": 600, "recover_after": 600},
     "decision": {"all": [
       {"signal": "region_a", "field": "status", "operator": "eq", "operand": "problem"},
       {"signal": "region_b", "field": "status", "operator": "eq", "operand": "problem"},
       {"signal": "control", "field": "status", "operator": "eq", "operand": "ok"},
       {"signal": "host_health", "field": "status", "operator": "eq", "operand": "ok"},
       {"signal": "traffic_ratio", "field": "value", "operator": "lt", "operand": {"meta": "ratio_threshold"}}
     ]}},
    {"key": "dead", "action": "Open a provider ticket.",
     "wait": {"confirm_after": 0, "recover_after": 300},
     "decision": {"any": [
       {"signal": "control", "field": "status", "operator": "eq", "operand": "problem"},
       {"signal": "host_health", "field": "status", "operator": "eq", "operand": "problem"}
     ]}},
    {"key": "checker_issue", "action": "Inspect the checker; do not replace the server.",
     "wait": {"confirm_after": 0, "recover_after": 0},
     "decision": {"all": [
       {"any": [
         {"signal": "region_a", "field": "status", "operator": "eq", "operand": "problem"},
         {"signal": "region_b", "field": "status", "operator": "eq", "operand": "problem"}
       ]},
       {"signal": "control", "field": "status", "operator": "eq", "operand": "ok"},
       {"signal": "host_health", "field": "status", "operator": "eq", "operand": "ok"},
       {"signal": "traffic_ratio", "field": "value", "operator": "gte", "operand": {"meta": "ratio_threshold"}}
     ]}}
  ]
}
